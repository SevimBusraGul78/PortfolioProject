@{
    var socials = ViewBag.socialMedias as List<MyAcademy_PortfolioProject.Entites.SocialMedia>
                  ?? new List<MyAcademy_PortfolioProject.Entites.SocialMedia>();
    string? h1Value = ViewBag.highlightValue1;
    string? h1Label = ViewBag.highlightLabel1;
    string? h2Value = ViewBag.highlightValue2;
    string? h2Label = ViewBag.highlightLabel2;
}

<style>
    .hero-art {
        position: relative;
        max-width: 500px;
        margin: 0 auto;
        aspect-ratio: 1 / 1.05;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    /* Arkadaki yeşil organik leke */
    .hero-art-blob {
        position: absolute;
        inset: 14% 4% 6% 10%;
        background: linear-gradient(160deg, #dfe7dc 0%, #c9d6c5 100%);
        border-radius: 58% 42% 50% 50% / 48% 55% 45% 52%;
        z-index: 0;
        animation: heroMorph 12s ease-in-out infinite;
    }

    /* Etrafındaki ince çizgi halka */
    .hero-art-ring {
        position: absolute;
        inset: 6% 0 2% 2%;
        border: 1.5px solid rgba(110, 135, 105, 0.35);
        border-radius: 45% 55% 52% 48% / 55% 45% 55% 45%;
        transform: rotate(-8deg);
        z-index: 0;
    }

    /* Fotoğraf: çerçevesiz, lekenin üzerine taşıyor */
    .hero-art-img {
        position: relative;
        z-index: 2;
        width: 90%;
        max-height: 540px;
        object-fit: contain;
        object-position: bottom;
        filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.12));
    }

    /* </> balonu */
    .hero-art-code {
        position: absolute;
        top: 20%;
        left: 4%;
        z-index: 3;
        background: #7d9478;
        color: #fff;
        font-family: Consolas, monospace;
        font-weight: 700;
        font-size: 1.1rem;
        padding: .45rem 1rem;
        border-radius: 999px;
        box-shadow: 0 8px 20px rgba(125, 148, 120, .35);
        animation: heroFloat 4s ease-in-out infinite;
    }

    /* Parıltı çizgileri */
    .hero-art-sparks {
        position: absolute;
        top: 3%;
        right: 12%;
        width: 54px;
        z-index: 3;
        color: #7d9478;
    }

    /* Yaprak dalı */
    .hero-art-leaves {
        position: absolute;
        bottom: 3%;
        left: -2%;
        width: 120px;
        z-index: 1;
        color: #8ea489;
        opacity: .85;
    }

    .hero-art .floating-badge {
        z-index: 4;
    }

        /* Hakkımda: ana sayfadaki görselin ayna hali */
    .hero-art--about .hero-art-ring { transform: rotate(8deg); }
    .hero-art--about .hero-art-code { left: auto; right: 2%; top: 14%; }
    .hero-art--about .hero-art-sparks { right: auto; left: 10%; transform: scaleX(-1); }
    .hero-art--about .hero-art-leaves { left: auto; right: -2%; transform: scaleX(-1); }
    .about-caption { text-align: center; margin-top: 1rem; }
    @@keyframes heroFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    @@keyframes heroMorph {
        0%, 100% {
            border-radius: 58% 42% 50% 50% / 48% 55% 45% 52%;
        }

        50% {
            border-radius: 48% 52% 42% 58% / 55% 45% 55% 45%;
        }
    }
</style>

<!-- 4. Hero Section -->
<section id="home">
    <div class="container">
        <div class="row align-items-center gy-5">
            <!-- Left Column -->
            <div class="col-lg-7 reveal-on-scroll is-revealed">
                <div class="eyebrow-badge">
                    <i class="bi bi-hand-wave-fill"></i> @ViewBag.greeting
                </div>

                <h1 class="hero-title">
                    @ViewBag.title
                </h1>

                <div class="typewriter-wrapper">
                    <span id="typewriterText"></span><span class="typing-cursor"></span>
                </div>

                <p class="hero-lead">
                    @ViewBag.description
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
                    <a href="#projects" class="btn-sage">
                        <span>Projelerimi Keşfet</span>
                        <i class="bi bi-arrow-down-right"></i>
                    </a>
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Benimle İletişime Geç</span>
                        <i class="bi bi-chat-text"></i>
                    </a>
                </div>

                @if (socials.Any())
                {
                    <div class="d-flex align-items-center gap-2 pt-2">
                        <span class="text-muted small me-2 font-heading fw-semibold">Takip Et:</span>
                        @foreach (var s in socials)
                        {
                            <a href="@s.Url" target="_blank" rel="noopener noreferrer" class="social-pill" title="@s.Platform">
                                <i class="@s.Icon"></i>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Right Column: İllüstrasyonlu görsel -->
            <div class="col-lg-5 reveal-on-scroll is-revealed">
                <div class="hero-art">
                    <div class="hero-art-ring"></div>
                    <div class="hero-art-blob"></div>

                    <!-- Yaprak dalı -->
                    <svg class="hero-art-leaves" viewBox="0 0 120 140" fill="currentColor" aria-hidden="true">
                        <path d="M58 140 C56 100 60 60 70 8" stroke="currentColor" stroke-width="2" fill="none" />
                        <ellipse cx="46" cy="112" rx="18" ry="7" transform="rotate(-30 46 112)" />
                        <ellipse cx="72" cy="96" rx="18" ry="7" transform="rotate(30 72 96)" />
                        <ellipse cx="48" cy="76" rx="16" ry="6" transform="rotate(-35 48 76)" />
                        <ellipse cx="74" cy="58" rx="15" ry="6" transform="rotate(35 74 58)" />
                        <ellipse cx="58" cy="36" rx="13" ry="5" transform="rotate(-40 58 36)" />
                    </svg>

                    <!-- Parıltı çizgileri -->
                    <svg class="hero-art-sparks" viewBox="0 0 60 50" fill="none" stroke="currentColor"
                         stroke-width="4" stroke-linecap="round" aria-hidden="true">
                        <line x1="10" y1="40" x2="14" y2="16" />
                        <line x1="26" y1="34" x2="40" y2="8" />
                        <line x1="34" y1="44" x2="54" y2="34" />
                    </svg>

                    <span class="hero-art-code">&lt;/&gt;</span>

                    @if (!string.IsNullOrEmpty(ViewBag.mainImageUrl as string))
                    {
                        <img src="@ViewBag.mainImageUrl" alt="@ViewBag.title" class="hero-art-img">
                    }

                    @if (!string.IsNullOrEmpty(h1Value))
                    {
                        <div class="floating-badge floating-badge-bottom">
                            <div class="skill-icon-box mb-0" style="width: 42px; height: 42px; background: var(--accent-sage-soft); color: var(--accent-sage-dark);">
                                <i class="bi bi-award-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold font-heading fs-6">@h1Value</div>
                                <div class="text-muted small">@h1Label</div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(h2Value))
                    {
                        <div class="floating-badge floating-badge-top d-none d-sm-flex">
                            <div class="skill-icon-box mb-0" style="width: 38px; height: 38px; background: var(--accent-terracotta-soft); color: var(--accent-terracotta);">
                                <i class="bi bi-rocket-takeoff-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold font-heading small">@h2Value</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@h2Label</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <div class="text-center mt-5 pt-4">
            <a href="#about" class="scroll-indicator">
                <div class="scroll-mouse">
                    <div class="scroll-dot"></div>
                </div>
                <span>Aşağı Kaydır</span>
            </a>
        </div>
    </div>
</section>