@model MyAcademy_PortfolioProject.Entites.About
@{
    var paragraphs = (Model.Content ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(p => p.Trim())
        .Where(p => p.Length > 0)
        .ToList();

    var stats = new[]
    {
        (Value: Model.Stat1Value, Label: Model.Stat1Label),
        (Value: Model.Stat2Value, Label: Model.Stat2Label),
        (Value: Model.Stat3Value, Label: Model.Stat3Label)
    }.Where(s => !string.IsNullOrEmpty(s.Value)).ToList();
}



<section id="about" class="bg-white border-top border-bottom">
    <div class="container">
        <div class="row align-items-center gy-5">

            <!-- Sol: Fotoğraf -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="hero-art hero-art--about">
                    <div class="hero-art-ring"></div>
                    <div class="hero-art-blob"></div>

                    <svg class="hero-art-leaves" viewBox="0 0 120 140" fill="currentColor" aria-hidden="true">
                        <path d="M58 140 C56 100 60 60 70 8" stroke="currentColor" stroke-width="2" fill="none" />
                        <ellipse cx="46" cy="112" rx="18" ry="7" transform="rotate(-30 46 112)" />
                        <ellipse cx="72" cy="96" rx="18" ry="7" transform="rotate(30 72 96)" />
                        <ellipse cx="48" cy="76" rx="16" ry="6" transform="rotate(-35 48 76)" />
                        <ellipse cx="74" cy="58" rx="15" ry="6" transform="rotate(35 74 58)" />
                        <ellipse cx="58" cy="36" rx="13" ry="5" transform="rotate(-40 58 36)" />
                    </svg>

                    <svg class="hero-art-sparks" viewBox="0 0 60 50" fill="none" stroke="currentColor"
                         stroke-width="4" stroke-linecap="round" aria-hidden="true">
                        <line x1="10" y1="40" x2="14" y2="16" />
                        <line x1="26" y1="34" x2="40" y2="8" />
                        <line x1="34" y1="44" x2="54" y2="34" />
                    </svg>

                    <span class="hero-art-code">&lt;/&gt;</span>

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Caption" class="hero-art-img">
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Caption) || !string.IsNullOrEmpty(Model.JobTitle))
                {
                    <div class="about-caption">
                        <span class="small text-muted font-heading">@Model.Caption</span>
                        @if (!string.IsNullOrEmpty(Model.JobTitle))
                        {
                            <span class="badge bg-secondary-subtle text-dark fw-medium ms-2">@Model.JobTitle</span>
                        }
                    </div>
                }
            </div>

            <!-- Sağ: Metin ve istatistikler -->
            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                </div>
                <h2 class="section-title">@Model.Heading</h2>

                <div class="text-muted fs-5 mb-4 lh-base">
                    @foreach (var p in paragraphs)
                    {
                        <p class="mb-3">@p</p>
                    }
                </div>

                @if (stats.Any())
                {
                    <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                        @foreach (var s in stats)
                        {
                            <div class="col-4">
                                <div class="stat-number">@s.Value</div>
                                <div class="stat-label">@s.Label</div>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.CvUrl))
                    {
                        <a href="@Model.CvUrl" target="_blank" rel="noopener noreferrer" class="btn-sage">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Özgeçmişimi İncele</span>
                        </a>
                    }
                    <a href="#contact" class="btn-secondary-custom">
                        <span>Bana Ulaşın</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>