@model MyAcademy_PortfolioProject.Entites.Education

@{
    ViewData["Title"] = "CreateEducation";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Eğitim</h1>
            <p class="page-subtitle">Okul, bölüm veya sertifika programı ekleyin.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Education/EducationList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i><span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form asp-action="CreateEducation" method="post">
            <partial name="_EducationForm" model="Model" />

            <div class="d-flex justify-content-end gap-2 mt-3">
                <a href="/Admin/Education/EducationList" class="btn-pastel-secondary">İptal</a>
                <button type="submit" class="btn-pastel-primary">
                    <i class="bi bi-check-lg"></i><span>Kaydet</span>
                </button>
            </div>
        </form>
    </div>
</main>