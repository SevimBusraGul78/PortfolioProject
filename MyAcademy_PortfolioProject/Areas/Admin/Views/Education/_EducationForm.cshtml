@model MyAcademy_PortfolioProject.Entites.Education

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label-custom">Okul / Kurum <span class="required-star">*</span></label>
        <input asp-for="SchoolName" class="form-control-custom" placeholder="Örn: Karabük Üniversitesi" />
        <span asp-validation-for="SchoolName" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label-custom">Bölüm / Program <span class="required-star">*</span></label>
        <input asp-for="Department" class="form-control-custom" placeholder="Örn: Bilgisayar Mühendisliği" />
        <span asp-validation-for="Department" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label-custom">Derece</label>
        <select asp-for="Degree" class="form-control-custom">
            <option value="">-- Seçiniz --</option>
            <option value="Lise">Lise</option>
            <option value="Ön Lisans">Ön Lisans</option>
            <option value="Lisans">Lisans</option>
            <option value="Yüksek Lisans">Yüksek Lisans</option>
            <option value="Doktora">Doktora</option>
            <option value="Sertifika / Kurs">Sertifika / Kurs</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label-custom">Başlangıç Yılı <span class="required-star">*</span></label>
        <input asp-for="StartYear" type="number" class="form-control-custom" placeholder="Örn: 2022" />
        <span asp-validation-for="StartYear" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label-custom">Bitiş Yılı</label>
        <input asp-for="EndYear" type="number" class="form-control-custom" placeholder="Boş = Devam ediyor" />
        <span asp-validation-for="EndYear" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label class="form-label-custom">Açıklama</label>
        <textarea asp-for="Description" class="form-control-custom" rows="3"
                  placeholder="Öne çıkan dersler, projeler, başarılar..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>