@model List<MyAcademy_PortfolioProject.Entites.Project>

@{
    ViewData["Title"] = "ProjeList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var activeCount = Model.Count(x => x.IsActive);
    var passiveCount = Model.Count(x => !x.IsActive);
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Projelerim</h1>
            <p class="page-subtitle">Projelerinizi yönetin. Pasif projeler sitede görünmez.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary">
                <i class="bi bi-tags"></i>
                <span>Kategoriler</span>
            </a>
            <a href="/Admin/Project/CreateProject" class="btn-pastel-primary">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Proje Ekle</span>
            </a>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green"><i class="bi bi-code-slash"></i></div>
            <div class="stat-content">
                <span class="stat-label">Toplam Proje</span>
                <h3 class="stat-value">@Model.Count</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Aktif</span>
                <h3 class="stat-value">@activeCount</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige"><i class="bi bi-pause-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Pasif</span>
                <h3 class="stat-value">@passiveCount</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">

        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="searchInput" placeholder="Proje adına göre ara..." oninput="filterTable()">
                </div>
                <select class="filter-select" id="statusFilter" onchange="filterTable()">
                    <option value="all">Durum (Tümü)</option>
                    <option value="Aktif">Aktif</option>
                    <option value="Pasif">Pasif</option>
                </select>
            </div>
        </div>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th style="width: 90px;">Görsel</th>
                        <th>Proje</th>
                        <th>Kategori</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 140px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="project-row"
                            data-title="@item.ProjectTitle.ToLower()"
                            data-status="@(item.IsActive ? "Aktif" : "Pasif")">
                            <td class="col-id">#@item.ProjectId</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" style="width:64px; height:44px; object-fit:cover; border-radius:8px;" />
                                }
                                else
                                {
                                    <span class="text-muted small">Yok</span>
                                }
                            </td>
                            <td>
                                <span class="exp-title-text">@item.ProjectTitle</span>
                                <small class="text-muted d-block" style="font-size:0.75rem;">@item.Technologies</small>
                            </td>
                            <td><span class="work-type-badge">@item.Category?.CategoryName</span></td>
                            <td><span class="date-badge">@item.CreatedDate.ToString("dd.MM.yyyy")</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-pill status-active">Aktif</span>
                                }
                                else
                                {
                                    <span class="status-pill status-passive">Pasif</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn-action-icon btn-delete" title="Sil"
                                            onclick="confirmDelete('/Admin/Project/DeleteProject/@item.ProjectId', '@item.ProjectTitle')">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function filterTable() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const status = document.getElementById('statusFilter').value;

        document.querySelectorAll('.project-row').forEach(row => {
            const matchTitle = row.dataset.title.includes(search);
            const matchStatus = status === 'all' || row.dataset.status === status;
            row.style.display = (matchTitle && matchStatus) ? '' : 'none';
        });
    }

    function confirmDelete(url, title) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: '"' + title + '" kalıcı olarak silinecek.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonText: 'Vazgeç',
            confirmButtonText: 'Evet, sil'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = url;
            }
        });
    }

    @if (TempData["Success"] != null)
    {
            <text>
            Swal.fire({
                icon: 'success',
                title: '@TempData["Success"]',
                timer: 2000,
                showConfirmButton: false
            });
            </text>
    }
</script>