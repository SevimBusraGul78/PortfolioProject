@model MyAcademy_PortfolioProject.Entites.Category

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Kategori</h1>
            <p class="page-subtitle">Örneğin: Web Uygulaması, Mobil, API</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form asp-action="CreateCategory" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom">Kategori Adı <span class="required-star">*</span></label>
                    <input asp-for="CategoryName" class="form-control-custom" placeholder="Örn: Web Uygulaması" />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Admin/Category/CategoryList" class="btn-pastel-secondary">İptal</a>
                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

</main>