@model List<MyAcademy_PortfolioProject.Entites.Message>

@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var unreadCount = Model.Count(x => !x.IsRead);
}

<style>
    .row-unread {
        background: #f3f8f4;
    }

        .row-unread .msg-sender, .row-unread .msg-subject {
            font-weight: 700;
        }

    .unread-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #2e7d5b;
        margin-right: 6px;
    }
</style>

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Gelen Kutusu</h1>
            <p class="page-subtitle">İletişim formundan gelen mesajlar. En yeni mesaj en üstte.</p>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue"><i class="bi bi-inbox"></i></div>
            <div class="stat-content">
                <span class="stat-label">Toplam Mesaj</span>
                <h3 class="stat-value">@Model.Count</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green"><i class="bi bi-envelope-exclamation"></i></div>
            <div class="stat-content">
                <span class="stat-label">Okunmamış</span>
                <h3 class="stat-value" id="unreadCounter">@unreadCount</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">

        <!-- Arama -->
        <div class="table-filter-bar">
            <form method="get" action="/Admin/Message/MessageList" class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Gönderen veya konuya göre ara...">
                </div>
                <button type="submit" class="btn-pastel-primary" style="padding: 7px 14px; font-size: 0.8rem;">Ara</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a href="/Admin/Message/MessageList" class="btn-table-util">Temizle</a>
                }
            </form>
        </div>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 170px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Mesaj bulunamadı.</td></tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.MessageId" class="@(item.IsRead ? "" : "row-unread")">
                            <td class="col-id">#@item.MessageId</td>
                            <td class="msg-sender">
                                @if (!item.IsRead)
                                {
                                    <span class="unread-dot" id="dot-@item.MessageId"></span>
                                }
                                @item.SenderName
                            </td>
                            <td class="msg-subject">@item.Subject</td>
                            <td><span class="date-badge">@item.SendDate.ToString("dd.MM.yyyy HH:mm")</span></td>
                            <td id="status-@item.MessageId">
                                @if (item.IsRead)
                                {
                                    <span class="status-pill status-passive">Okundu</span>
                                }
                                else
                                {
                                    <span class="status-pill status-active">Yeni</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <button type="button" class="btn-action-icon btn-view" title="Mesajı Aç"
                                            onclick="openMessage(@item.MessageId)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a href="/Admin/Message/ToggleRead/@item.MessageId" class="btn-action-icon btn-edit"
                                       title="@(item.IsRead ? "Okunmadı yap" : "Okundu yap")">
                                        <i class="bi @(item.IsRead ? "bi-envelope" : "bi-envelope-open")"></i>
                                    </a>
                                    <a href="/Admin/Message/DeleteMessage/@item.MessageId"
                                       class="btn-action-icon btn-delete js-confirm-delete" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</main>

<!-- Mesaj Detay Modalı -->
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 16px;">
            <div class="modal-header">
                <h5 class="modal-title" id="modalSubject">Yükleniyor...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
