@model MyAcademy_PortfolioProject.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int total = Model.TotalMessageCount;
    int unread = Model.UnreadMessageCount;
    int read = total - unread;
    int rate = total == 0 ? 0 : read * 100 / total;

    int maxCat = Model.CategorySummaries.Any() ? Model.CategorySummaries.Max(x => x.ProjectCount) : 1;
}

<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .db-title small {
            color: var(--muted);
            font-weight: 400;
        }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green {
        background: var(--g-soft);
        color: var(--g);
    }

    .c-blue {
        background: #e6eef8;
        color: #3b6ea5;
    }

    .c-rose {
        background: #f9e7e7;
        color: #b44b4b;
    }

    .c-beige {
        background: #f4efe6;
        color: #8a6d3b;
    }

    .c-purple {
        background: #efe9f6;
        color: #6b537e;
    }

    .bars {
        display: flex;
        align-items: flex-end;
        gap: .8rem;
        height: 190px;
    }

    .bar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        height: 100%;
        gap: .4rem;
    }

    .bar-fill {
        width: 100%;
        max-width: 42px;
        background: var(--g);
        border-radius: 8px 8px 4px 4px;
        opacity: .85;
        transition: opacity .2s;
        min-height: 6px;
    }

    .bar:hover .bar-fill {
        opacity: 1;
    }

    .bar span {
        font-size: .75rem;
        color: var(--muted);
        text-align: center;
    }

    .bar b {
        font-size: .8rem;
    }

    .donut {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: .5rem auto 1.2rem;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--g) calc(var(--p) * 1%), var(--g-soft) 0);
    }

        .donut div {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 1.6rem;
            font-weight: 700;
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            margin-right: .35rem;
        }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .8rem 0;
        border-bottom: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
    }

        .msg-row:last-child {
            border-bottom: none;
        }

        .msg-row:hover {
            background: #fafaf7;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .6rem;
        border-radius: 20px;
    }

    .proj-thumb {
        width: 56px;
        height: 40px;
        object-fit: cover;
        border-radius: 8px;
        background: var(--g-soft);
        flex-shrink: 0;
        display: grid;
        place-items: center;
        color: var(--g);
    }

    .quick-btn {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .9rem 1rem;
        border: 1px solid var(--line);
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        font-weight: 600;
        transition: background .2s;
    }

        .quick-btn:hover {
            background: var(--g-soft);
            color: var(--g);
        }
</style>

<div class="db container-fluid py-3">

    <!-- Hızlı erişim -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a href="/Admin/Project/CreateProject" class="quick-btn"><i class="bi bi-plus-circle"></i> Yeni Proje Ekle</a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="/Admin/Message/MessageList" class="quick-btn">
                <i class="bi bi-inbox"></i> Mesajları Gör
                @if (unread > 0)
                {
                    <span class="badge-soft c-rose ms-auto">@unread yeni</span>
                }
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="/Admin/SkillItem/CreateSkillItem" class="quick-btn"><i class="bi bi-stars"></i> Yetenek Ekle</a>
        </div>
        <div class="col-6 col-lg-3">
            <a href="/" target="_blank" class="quick-btn"><i class="bi bi-box-arrow-up-right"></i> Siteyi Görüntüle</a>
        </div>
    </div>

    <!-- İstatistik kartları -->
    @{
        var stats = new[] {
        (Val: Model.TotalProjectCount,  Lbl: "Toplam Proje",  Icon: "bi-code-slash",           Cls: "c-green"),
        (Val: Model.ActiveProjectCount, Lbl: "Aktif Proje",   Icon: "bi-check2-circle",        Cls: "c-blue"),
        (Val: Model.SkillCount,         Lbl: "Yetenek",       Icon: "bi-stars",                Cls: "c-purple"),
        (Val: Model.ExperienceCount,    Lbl: "Deneyim",       Icon: "bi-briefcase",            Cls: "c-beige"),
        (Val: Model.EducationCount,     Lbl: "Eğitim",        Icon: "bi-mortarboard",          Cls: "c-green"),
        (Val: total,                    Lbl: "Toplam Mesaj",  Icon: "bi-envelope",             Cls: "c-blue"),
        (Val: unread,                   Lbl: "Okunmamış",     Icon: "bi-envelope-exclamation", Cls: "c-rose")
        };
    }
    <div class="row g-4 mb-4">
        @foreach (var s in stats)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="db-card stat">
                    <div class="stat-icon @s.Cls"><i class="bi @s.Icon"></i></div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row g-4 mb-4">
        <!-- Kategori özeti (GroupBy) -->
        <div class="col-xl-8">
            <div class="db-card">
                <div class="db-title">Kategori Özeti <small>Kategori başına proje sayısı</small></div>
                @if (!Model.CategorySummaries.Any())
                {
                    <p class="text-muted">Henüz proje eklenmemiş.</p>
                }
                else
                {
                    <div class="bars">
                        @foreach (var c in Model.CategorySummaries)
                        {
                            <div class="bar">
                                <b>@c.ProjectCount</b>
                                <div class="bar-fill" style="height:@(c.ProjectCount * 100 / maxCat)%"></div>
                                <span>@c.CategoryName</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Okunma oranı -->
        <div class="col-xl-4">
            <div class="db-card">
                <div class="db-title">Okunma Oranı</div>
                <div class="donut" style="--p:@rate"><div>%@rate</div></div>
                <div class="legend">
                    <span><i style="background:var(--g)"></i>Okundu (@read)</span>
                    <span><i style="background:var(--g-soft)"></i>Okunmadı (@unread)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Son 5 mesaj -->
        <div class="col-xl-7">
            <div class="db-card">
                <div class="db-title">
                    Son Mesajlar
                    <a href="/Admin/Message/MessageList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
                </div>

                @if (!Model.LastMessages.Any())
                {
                    <p class="text-muted">Henüz mesaj yok.</p>
                }

                @foreach (var m in Model.LastMessages)
                {
                    <a href="/Admin/Message/MessageList" class="msg-row">
                        <div class="avatar">@(string.IsNullOrEmpty(m.SenderName) ? "?" : m.SenderName.Substring(0, 1).ToUpper())</div>
                        <div class="msg-body">
                            <strong>@m.SenderName</strong> · <span class="small">@m.Subject</span>
                            <p>@m.MessageDetail</p>
                        </div>
                        <small class="text-muted d-none d-md-block">@m.SendDate.ToString("dd MMM, HH:mm", new System.Globalization.CultureInfo("tr-TR"))</small>
                        @if (m.IsRead)
                        {
                            <span class="badge-soft c-blue">Okundu</span>
                        }
                        else
                        {
                            <span class="badge-soft c-rose">Yeni</span>
                        }
                    </a>
                }
            </div>
        </div>

        <!-- Son 3 proje -->
        <div class="col-xl-5">
            <div class="db-card">
                <div class="db-title">
                    Son Eklenen Projeler
                    <a href="/Admin/Project/ProjeList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
                </div>

                @if (!Model.LastProjects.Any())
                {
                    <p class="text-muted">Henüz proje yok.</p>
                }

                @foreach (var p in Model.LastProjects)
                {
                    <a href="/Admin/Project/UpdateProject/@p.ProjectId" class="msg-row">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@p.ImageUrl" class="proj-thumb" />
                        }
                        else
                        {
                            <div class="proj-thumb"><i class="bi bi-code-square"></i></div>
                        }
                        <div class="msg-body">
                            <strong>@p.ProjectTitle</strong>
                            <p>@p.Category?.CategoryName</p>
                        </div>
                        @if (p.IsActive)
                        {
                            <span class="badge-soft c-green">Aktif</span>
                        }
                        else
                        {
                            <span class="badge-soft c-rose">Pasif</span>
                        }
                    </a>
                }
            </div>
        </div>
    </div>
</div>