@model MyAcademy_PortfolioProject.Entites.HeroSection

@{
    ViewData["Title"] = "EditHero";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Hakkımda / Ana Sayfa</h1>
            <p class="page-subtitle">Sitenin en üstündeki tanıtım bölümünde görünen bilgiler.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/About/EditAbout" class="btn-pastel-secondary">
                <i class="bi bi-person-lines-fill"></i><span>Beni Tanıyın Bölümü</span>
            </a>
            <a href="/" target="_blank" class="btn-pastel-secondary">
                <i class="bi bi-box-arrow-up-right"></i><span>Sitede Gör</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form asp-action="EditHero" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="HeroSectionId" />

            <div class="row g-3">

                <!-- Sol: metinler -->
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-custom">Selamlama <span class="required-star">*</span></label>
                            <input asp-for="Greeting" class="form-control-custom" placeholder="Örn: Merhaba, ben" />
                            <span asp-validation-for="Greeting" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">İsim / Başlık <span class="required-star">*</span></label>
                            <input asp-for="Title" class="form-control-custom" placeholder="Örn: Büşra Sevim" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label-custom">Tanıtım Metni <span class="required-star">*</span></label>
                            <textarea asp-for="Description" class="form-control-custom" rows="4"
                                      placeholder="Kendinizi birkaç cümleyle tanıtın..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Sağ: fotoğraf -->
                <div class="col-lg-4">
                    <label class="form-label-custom">Profil Fotoğrafı</label>
                    <div class="mb-2">
                        <img id="imagePreview"
                             src="@Model.MainImageUrl"
                             style="width:100%; max-height:220px; object-fit:cover; border-radius:16px; border:1px solid #e5e5e5; @(string.IsNullOrEmpty(Model.MainImageUrl) ? "display:none;" : "")" />
                    </div>
                    <input type="file" name="imageFile" class="form-control-custom"
                           accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
                    <small class="text-muted d-block">Boş bırakırsanız mevcut fotoğraf korunur.</small>
                    <span asp-validation-for="MainImageUrl" class="text-danger small"></span>
                </div>

                <!-- Öne çıkan bilgiler -->
                <div class="col-12 mt-4">
                    <h6 class="fw-bold mb-1">Öne Çıkan Bilgiler</h6>
                    <small class="text-muted">Fotoğrafın üzerindeki küçük rozetler. Boş bırakılan rozet sitede görünmez.</small>
                </div>

                <div class="col-md-3">
                    <label class="form-label-custom">Rozet 1 - Değer</label>
                    <input asp-for="HighlightValue1" class="form-control-custom" placeholder="Örn: 2+ Yıllık" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-custom">Rozet 1 - Açıklama</label>
                    <input asp-for="HighlightLabel1" class="form-control-custom" placeholder="Örn: Yazılım Deneyimi" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-custom">Rozet 2 - Değer</label>
                    <input asp-for="HighlightValue2" class="form-control-custom" placeholder="Örn: 15+ Proje" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-custom">Rozet 2 - Açıklama</label>
                    <input asp-for="HighlightLabel2" class="form-control-custom" placeholder="Örn: Tamamlanan İş" />
                </div>

                <div class="col-12 d-flex justify-content-end mt-3">
                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    </button>
                </div>

            </div>
        </form>
    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        if (input.files && input.files[0]) {
            preview.src = URL.createObjectURL(input.files[0]);
            preview.style.display = 'block';
        }
    }

    @if (TempData["Success"] != null)
    {
            <text>
            Swal.fire({ icon: 'success', title: '@TempData["Success"]', timer: 2000, showConfirmButton: false });
            </text>
    }
</script>