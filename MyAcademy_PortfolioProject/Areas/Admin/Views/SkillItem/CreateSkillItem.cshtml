@model MyAcademy_PortfolioProject.Entites.SkillItem

@{
    ViewData["Title"] = "CreateSkillItem";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Yetenek</h1>
            <p class="page-subtitle">Yetenek adını, grubunu ve seviyesini giriniz.</p>
        </div>
        <div class="header-actions">
            <a href="/Admin/SkillItem/SkillItemList" class="btn-pastel-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Listeye Dön</span>
            </a>
        </div>
    </div>

    <div class="side-drawer-card">
        <form asp-action="CreateSkillItem" method="post">
            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label-custom">Yetenek Adı <span class="required-star">*</span></label>
                    <input asp-for="SkillItemTitle" class="form-control-custom" placeholder="Örn: HTML" />
                    <span asp-validation-for="SkillItemTitle" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label-custom">Grup <span class="required-star">*</span></label>
                    <select asp-for="SkillId" asp-items="ViewBag.SkillGroups" class="form-control-custom">
                        <option value="">-- Grup seçiniz --</option>
                    </select>
                    <span asp-validation-for="SkillId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label-custom">
                        Seviye: <strong id="levelText">%50</strong>
                    </label>
                    <input asp-for="Level" type="range" min="0" max="100" value="50" class="form-range"
                           oninput="document.getElementById('levelText').innerText = '%' + this.value" />
                    <span asp-validation-for="Level" class="text-danger small"></span>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <a href="/Admin/SkillItem/SkillItemList" class="btn-pastel-secondary">İptal</a>
                    <button type="submit" class="btn-pastel-primary">
                        <i class="bi bi-check-lg"></i>
                        <span>Kaydet</span>
                    </button>
                </div>

            </div>
        </form>
    </div>

</main>